# Godot 4
.godot/
/android/

# gs-core is a separate repository. For local development, symlink it:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# Consumers copy both addons into their own project.
/addons/gs_core
# gs-server, for examples/session_reporter_selftest.tscn only (the addon never names it):
#   ln -s ../../gs-server/addons/gs_server addons/gs_server
/addons/gs_server

# Exports
build/
export_presets.cfg

# Signing keys and credentials must never be committed.
*.key
*.pem
keys/
gs_auth*.json

# OS
.DS_Store
Thumbs.db

# Linked addons (separate repositories, symlinked in for local development).
/addons/gs_cloud
/addons/gs_moderation
/addons/gs_sql
/addons/gs_voice
